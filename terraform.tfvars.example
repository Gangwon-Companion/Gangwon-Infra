aws_region        = "ap-northeast-2"
aws_account_id    = "123456789012"
project_name      = "gangwon-companion"
environment       = "prod"
be_image_tag      = "latest"
ai_image_tag      = "latest"
ecs_desired_count = 0

# Set these before a public web/mobile production release.
# acm_certificate_arn         = "arn:aws:acm:ap-northeast-2:123456789012:certificate/..."
# cors_allowed_origin_patterns = "https://app.example.com"

spring_jpa_ddl_auto     = "update"
ai_response_llm_enabled = false
ai_response_llm_model   = "gpt-4.1"
openai_base_url         = "https://api.openai.com"

# alarm_action_arns = ["arn:aws:sns:ap-northeast-2:123456789012:operations"]

